{
  "name": "leaderboard-github-scraper",
  "version": "1.0.0",
  "description": "GitHub scraper for Leaderboard",
  "type": "module",
  "main": "./dist/manifest.mjs",
  "exports": {
    ".": "./dist/manifest.mjs"
  },
  "scripts": {
    "build": "esbuild manifest.ts --bundle --platform=node --format=esm --outfile=dist/manifest.mjs --external:@leaderboard/core",
    "lint": "eslint"
  },
  "keywords": [
    "leaderboard",
    "github",
    "scraper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohcnetwork/leaderboard-github-scraper.git"
  },
  "author": "Open Healthcare Network",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ohcnetwork/leaderboard-github-scraper/issues"
  },
  "homepage": "https://github.com/ohcnetwork/leaderboard-github-scraper#readme",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@leaderboard/core": "file:../leaderboard/packages/core",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.1",
    "octokit": "^5.0.5",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
